# ---- runtime ----
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Public HTTPS URL of this backend (App Runner URL). Enables Hunar webhooks. Leave empty locally.
PUBLIC_BASE_URL=
# Optional demo gate; when set the frontend must send X-Access-Code.
APP_ACCESS_CODE=

# ---- database (fields are snake_case, matching the Python code) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ringside

# ---- Hunar Voice Agents ----
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
HUNAR_TIMEZONE=Asia/Kolkata

# ---- safe dial: every call goes to the first test number unless a candidate is cleared ----
SAFE_DIAL_MODE=true
TEST_PHONE_NUMBERS=+91XXXXXXXXXX

# ---- background sync (fallback when webhooks can't reach us) ----
POLLER_ENABLED=true
POLLER_INTERVAL_SECONDS=30

# ---- LLM via OpenRouter ----
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5
LLM_AUDIO_MODEL=google/gemini-2.5-flash

# ---- people search providers (optional; the mock provider is always on) ----
APOLLO_API_KEY=
PDL_API_KEY=
