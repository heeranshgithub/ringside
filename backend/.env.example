# ---- runtime ----
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Public HTTPS URL of this backend. When set, calls are created with webhook callbacks so
# Hunar pushes updates instead of us polling for them. Leave empty for plain local dev;
# `uv run python scripts/tunnel.py` fills it in from a cloudflared tunnel and clears it on exit.
PUBLIC_BASE_URL=
# Optional demo gate; when set the frontend must send X-Access-Code.
APP_ACCESS_CODE=

# ---- database (fields are snake_case, matching the Python code) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ringside

# ---- Hunar Voice Agents ----
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
HUNAR_TIMEZONE=Asia/Kolkata

# ---- safe dial: every call goes to the first test number unless a candidate is cleared ----
SAFE_DIAL_MODE=true
TEST_PHONE_NUMBERS=+91XXXXXXXXXX

# Let a visitor nominate their own phone, proven by one short verification call. OFF by
# default: with it on the product will ring a number a browser supplied. It refuses to arm
# unless APP_ACCESS_CODE is also set, so a leaked URL alone cannot dial anyone.
ALLOW_CLIENT_DIAL_TARGET=false
DIAL_VERIFY_PER_NUMBER_PER_DAY=3
DIAL_VERIFY_PER_SESSION_PER_DAY=5
DIAL_TARGET_TTL_HOURS=12

# ---- background sync (fallback when webhooks can't reach us) ----
POLLER_ENABLED=true
POLLER_INTERVAL_SECONDS=30

# ---- LLM via OpenRouter ----
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5
LLM_AUDIO_MODEL=google/gemini-2.5-flash
# Without a key, every LLM feature refuses with an error naming the cause.
# There is no fallback implementation and no flag to enable one.

# ---- people search providers (optional; the demo dataset is always on) ----
# Ringside never dials a sourced number, so a provider only has to prove the search is
# real. Judge them on that, not on whether they sell contact data.
#
# People Data Labs: 100 free searches/month, 1 credit per profile returned. The sandbox
# serves synthetic records with an identical schema at zero credits, so leave it on for
# development and set it false only for the real demo.
PDL_API_KEY=
PDL_SANDBOX=true
#
# Coresignal: search is free and returns ids; each profile shown costs 20 credits.
# The 7-day trial carries 2,000, so MAX_COLLECT caps what one search can spend.
CORESIGNAL_API_KEY=
CORESIGNAL_MAX_COLLECT=10
#
# Apollo.io: searching costs no credits, but API access is gated to their paid plans and
# results come back masked. Try creating a key before planning around it.
APOLLO_API_KEY=
